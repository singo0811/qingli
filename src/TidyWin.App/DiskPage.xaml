<UserControl
    x:Class="TidyWin.App.DiskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TidyWin.Core.Localization"
    xmlns:local="using:TidyWin.App">

    <Grid Padding="44,30,44,28">

        <!-- ───────── 选盘 + 系统里常见的大文件 ───────── -->
        <ScrollViewer x:Name="IntroView" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind loc:Loc.T('磁盘分析')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('空间都去哪了')}" FontSize="32" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('选一个盘,一层层看哪个文件夹最占地方。只读取,不会改动任何东西。')}" FontSize="14"
                               Foreground="{x:Bind local:Palette.Dim}" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DriveRow">
                            <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14" Padding="20,14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                                        <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" Height="5" CornerRadius="3" Foreground="{x:Bind local:Palette.UsageBrush(UsedPercent)}" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{x:Bind local:Palette.Dim}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind loc:Loc.T('分析这个盘')}" Click="OnScanDrive" Tag="{x:Bind Path}" Padding="20,9"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="KnownPanel" Spacing="10" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="{x:Bind loc:Loc.T('这些是 Windows 里常见的大文件,先看说明再决定')}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{x:Bind local:Palette.Text}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('它们不是普通垃圾,不能直接删。每一项都写了正确的处理办法。')}" FontSize="12" Foreground="{x:Bind local:Palette.Faint}" />
                    <ItemsControl ItemsSource="{x:Bind Known}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KnownRow">
                                <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="12" Padding="18,12">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontFamily="Bahnschrift" FontSize="18" Foreground="{x:Bind local:Palette.Text}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind About}" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind HowTo}" FontSize="13" Foreground="{x:Bind local:Palette.Text}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:Palette.VisText(Command)}">
                                            <TextBlock Text="{x:Bind Command}" FontFamily="Cascadia Mono" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{x:Bind local:Palette.Faint}" />
                                            <Button Content="{x:Bind loc:Loc.T('复制命令')}" Click="OnCopy" Tag="{x:Bind Command}" Padding="10,3" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── 分析中 ───────── -->
        <StackPanel x:Name="ScanView" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20"
                    Visibility="Collapsed" Width="640">
            <TextBlock x:Name="ScanTitle" Text="{x:Bind loc:Loc.T('正在分析')}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{x:Bind local:Palette.Text}" />
            <Grid x:Name="ScanTrack" Width="440" Height="4" CornerRadius="2" Background="#1A2231">
                <Border Width="170" HorizontalAlignment="Left" CornerRadius="2">
                    <Border.RenderTransform><TranslateTransform x:Name="ScanShift" X="-170" /></Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0035F2B3" Offset="0" />
                            <GradientStop Color="#FF35F2B3" Offset="0.5" />
                            <GradientStop Color="#0019B9E6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <TextBlock x:Name="ScanCount" FontSize="15" HorizontalAlignment="Center" Foreground="{x:Bind local:Palette.Text}" />
            <TextBlock x:Name="ScanPath" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{x:Bind local:Palette.Faint}" TextTrimming="CharacterEllipsis" MaxWidth="640" />
            <Button Content="{x:Bind loc:Loc.T('停止')}" Click="OnStop" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ───────── 结果 ───────── -->
        <Grid x:Name="ReadyView" RowSpacing="14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock x:Name="CrumbText" FontFamily="Cascadia Mono" FontSize="12" Foreground="{x:Bind local:Palette.Dim}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="HeroNumber" Text="0" FontFamily="Bahnschrift" FontSize="80" FontWeight="SemiLight" LineHeight="84" />
                    <TextBlock x:Name="HeroUnit" Text="B" FontFamily="Bahnschrift" FontSize="26" VerticalAlignment="Bottom"
                               Margin="0,0,0,12" Foreground="{x:Bind local:Palette.Dim}" />
                </StackPanel>
                <TextBlock x:Name="HeroSub" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="UpButton" Content="{x:Bind loc:Loc.T('上一级')}" Click="OnUp" />
                <Button Content="{x:Bind loc:Loc.T('回到起点')}" Click="OnHome" />
                <Button Content="{x:Bind loc:Loc.T('重新分析')}" Click="OnRescan" />
                <Button Content="{x:Bind loc:Loc.T('换一个盘')}" Click="OnPickAnother" />
            </StackPanel>

            <Border x:Name="MessageBar" Grid.Row="2" Background="#10222B" BorderBrush="#1E4A44" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" VerticalAlignment="Center" />
                    <Button x:Name="BinButton" Grid.Column="1" Content="{x:Bind loc:Loc.T('打开回收站')}" Click="OnOpenBin" Visibility="Collapsed" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FoldersTitle" Text="{x:Bind loc:Loc.T('文件夹')}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Dim}" />
                    <ItemsControl ItemsSource="{x:Bind Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DiskRow">
                                <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="12" Padding="18,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{x:Bind Percent}" Maximum="100" Height="4" CornerRadius="2" Foreground="{x:Bind local:Palette.CyanBrush}" />
                                            <TextBlock Text="{x:Bind Sub}" FontSize="11" Foreground="{x:Bind local:Palette.Faint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="86">
                                            <TextBlock Text="{x:Bind SizeText}" FontFamily="Bahnschrift" FontSize="20" HorizontalAlignment="Right"
                                                       Foreground="{x:Bind local:Palette.Text}" />
                                            <TextBlock Text="{x:Bind ShareText}" FontSize="11" HorizontalAlignment="Right" Foreground="{x:Bind local:Palette.Dim}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{x:Bind loc:Loc.T('打开')}" Click="OnEnter" Padding="12,5" Visibility="{x:Bind local:Palette.Vis(CanEnter)}" />
                                            <Button Content="{x:Bind loc:Loc.T('显示')}" Click="OnReveal" Padding="12,5" Visibility="{x:Bind local:Palette.Vis(CanReveal)}" />
                                            <Button Content="{x:Bind loc:Loc.T('回收站')}" Click="OnRecycle" Padding="12,5" Visibility="{x:Bind local:Palette.Vis(CanRecycle)}" />
                                            <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{x:Bind local:Palette.Faint}"
                                                      Visibility="{x:Bind local:Palette.Vis(IsProtected)}"
                                                      ToolTipService.ToolTip="{x:Bind WhyNot}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="FilesTitle" Text="{x:Bind loc:Loc.T('这里面最大的文件')}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                               Foreground="{x:Bind local:Palette.Dim}" />
                    <ItemsControl ItemsSource="{x:Bind Files}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:DiskRow">
                                <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="12" Padding="18,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Sub}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{x:Bind local:Palette.Faint}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontFamily="Bahnschrift" FontSize="20" VerticalAlignment="Center"
                                                   MinWidth="86" TextAlignment="Right" Foreground="{x:Bind local:Palette.Text}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{x:Bind loc:Loc.T('显示')}" Click="OnReveal" Padding="12,5" />
                                            <Button Content="{x:Bind loc:Loc.T('回收站')}" Click="OnRecycle" Padding="12,5" Visibility="{x:Bind local:Palette.Vis(CanRecycle)}" />
                                            <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{x:Bind local:Palette.Faint}"
                                                      Visibility="{x:Bind local:Palette.Vis(IsProtected)}"
                                                      ToolTipService.ToolTip="{x:Bind WhyNot}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
