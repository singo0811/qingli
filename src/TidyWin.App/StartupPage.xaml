<UserControl
    x:Class="TidyWin.App.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TidyWin.Core.Localization"
    xmlns:local="using:TidyWin.App"
    xmlns:vm="using:TidyWin.ViewModels">

    <Grid Padding="44,30,44,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{x:Bind loc:Loc.T('开机启动')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="HeroNumber" Text="0" FontFamily="Bahnschrift" FontSize="96" FontWeight="SemiLight" LineHeight="100" />
                <TextBlock Text="{x:Bind loc:Loc.T('个程序随开机启动')}" FontSize="20" VerticalAlignment="Bottom" Margin="0,0,0,18"
                           Foreground="{x:Bind local:Palette.Dim}" />
            </StackPanel>
            <TextBlock x:Name="HeroSub" FontSize="14" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BulkButton" Grid.Column="0" Click="OnDisableSuggested" Padding="22,9" CornerRadius="10"
                    FontWeight="SemiBold" Foreground="#04110C">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#35F2B3" Offset="0" />
                        <GradientStop Color="#19B9E6" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
                <TextBlock x:Name="BulkText" Text="{x:Bind loc:Loc.T('关掉不影响使用的')}" />
            </Button>
            <Button Grid.Column="1" Content="{x:Bind loc:Loc.T('重新读取')}" Click="OnRefresh" />
            <TextBlock x:Name="MessageText" Grid.Column="2" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{x:Bind local:Palette.Text}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="10">
                <TextBlock x:Name="EmptyText" FontSize="16" Foreground="{x:Bind local:Palette.Dim}" Visibility="Collapsed"
                           Text="{x:Bind loc:Loc.T('没有读到开机启动项。')}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupItemViewModel">
                            <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14">
                                <Grid MinHeight="84">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{x:Bind local:Palette.StartupBrush(Advice)}" CornerRadius="14,0,0,14" />

                                    <StackPanel Grid.Column="1" Padding="20,12,12,12" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind KindLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:Palette.StartupBrush(Advice)}" />
                                            <TextBlock Text="{x:Bind loc:Loc.T('需要管理员权限才能改')}" FontSize="12" Foreground="{x:Bind local:Palette.Faint}"
                                                       Visibility="{x:Bind local:Palette.Vis(IsMachineWide)}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{x:Bind local:Palette.Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Note}" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Command}" FontFamily="Cascadia Mono" FontSize="11"
                                                   Foreground="{x:Bind local:Palette.Faint}" TextTrimming="CharacterEllipsis" MaxWidth="600"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Padding="12,12,22,12" Spacing="6" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" MinWidth="110">
                                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnToggled"
                                                      OnContent="{x:Bind loc:Loc.T('开')}" OffContent="{x:Bind loc:Loc.T('关')}" MinWidth="0" HorizontalAlignment="Right"
                                                      AutomationProperties.Name="{x:Bind Name}" />
                                        <Button Content="{x:Bind loc:Loc.T('移除')}" Click="OnRemove" Padding="12,4" FontSize="12" HorizontalAlignment="Right"
                                                Visibility="{x:Bind local:Palette.Vis(CanRemove)}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
