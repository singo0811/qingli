<UserControl
    x:Class="TidyWin.App.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TidyWin.Core.Localization"
    xmlns:local="using:TidyWin.App"
    xmlns:vm="using:TidyWin.ViewModels">

    <Grid Padding="44,30,44,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 英雄区 -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind loc:Loc.T('可用内存')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="HeroNumber" Text="0" FontFamily="Bahnschrift" FontSize="116"
                               FontWeight="SemiLight" LineHeight="120" />
                    <TextBlock x:Name="HeroUnit" Text="GB" FontFamily="Bahnschrift" FontSize="34"
                               VerticalAlignment="Bottom" Margin="0,0,0,22" Foreground="{x:Bind local:Palette.Dim}" />
                </StackPanel>
                <TextBlock x:Name="HeroSub" FontSize="14" Foreground="{x:Bind local:Palette.Dim}" />
            </StackPanel>

            <Border x:Name="PressureChip" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="16"
                    Padding="16,7" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="PressureDot" Width="9" Height="9" VerticalAlignment="Center" />
                    <TextBlock x:Name="PressureText" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 占用条 + 整理 -->
        <StackPanel Grid.Row="1" Spacing="16">
            <Grid Height="14" ColumnSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UsedCol" Width="1*" />
                    <ColumnDefinition x:Name="FreeCol" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="UsedBar" Grid.Column="0" CornerRadius="7" />
                <Border Grid.Column="1" CornerRadius="7" Background="#1A2231" />
            </Grid>

            <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="16" Padding="22,16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="TrimTitle" FontSize="17" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                        <TextBlock x:Name="TrimResult" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="TrimButton" Grid.Column="1" Click="OnTrimIdle" Padding="28,11" CornerRadius="12"
                            FontWeight="SemiBold" FontSize="15" Foreground="#04110C" VerticalAlignment="Center">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#35F2B3" Offset="0" />
                                <GradientStop Color="#19B9E6" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock x:Name="TrimButtonText" Text="{x:Bind loc:Loc.T('整理后台程序')}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 下半部分 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel Spacing="22">

                <TextBlock x:Name="NoticeText" FontSize="13" Foreground="{x:Bind local:Palette.Dim}"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- 疑似泄漏 -->
                <Border x:Name="AlertCard" Visibility="Collapsed" Background="#1A1410" BorderBrush="#4A3320"
                        BorderThickness="1" CornerRadius="14" Padding="20,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FFB84D" />
                            <TextBlock Text="{x:Bind loc:Loc.T('内存一直在涨')}" FontSize="15" FontWeight="SemiBold" Foreground="#FFB84D" />
                        </StackPanel>
                        <StackPanel x:Name="AlertLines" Spacing="3" />
                        <TextBlock Text="{x:Bind loc:Loc.T('持续上涨通常是程序有泄漏。重启一下这个程序就能收回。')}" FontSize="12"
                                   Foreground="{x:Bind local:Palette.Dim}" />
                    </StackPanel>
                </Border>

                <!-- Ollama -->
                <Border x:Name="OllamaCard" Visibility="Collapsed" Background="#0F1520" BorderBrush="#1D2636"
                        BorderThickness="1" CornerRadius="14" Padding="20,14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{x:Bind local:Palette.Dim}" />
                            <TextBlock Text="{x:Bind loc:Loc.T('Ollama 里常驻的模型')}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:Palette.Text}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LoadedModelViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" VerticalAlignment="Center"
                                                   Foreground="{x:Bind local:Palette.Text}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Where}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{x:Bind local:Palette.Dim}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontFamily="Bahnschrift" FontSize="20"
                                                   VerticalAlignment="Center" Foreground="{x:Bind local:Palette.Text}" />
                                        <Button Grid.Column="3" Content="{x:Bind loc:Loc.T('卸载')}" Click="OnUnload" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind loc:Loc.T('卸载只是让 Ollama 把模型从内存里拿走,模型文件还在,下次用会自动重新载入。')}" FontSize="12"
                                   Foreground="{x:Bind local:Palette.Faint}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 谁在占内存 -->
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind loc:Loc.T('谁在占内存')}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Dim}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryGroupViewModel">
                                <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="12">
                                    <Grid MinHeight="62" Padding="18,10,14,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{x:Bind local:Palette.Text}" />
                                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{x:Bind local:Palette.State(State), Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="12"
                                                       Foreground="{x:Bind local:Palette.Faint}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind WorkingSetText, Mode=OneWay}"
                                                   FontFamily="Bahnschrift" FontSize="24" VerticalAlignment="Center"
                                                   MinWidth="96" TextAlignment="Right" Foreground="{x:Bind local:Palette.Text}" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                    MinWidth="132" HorizontalAlignment="Right">
                                            <Button Content="{x:Bind loc:Loc.T('整理')}" Click="OnTrimGroup"
                                                    Visibility="{x:Bind local:Palette.Vis(CanTrim), Mode=OneWay}" />
                                            <Button Content="{x:Bind loc:Loc.T('关闭')}" Click="OnCloseGroup"
                                                    Visibility="{x:Bind local:Palette.Vis(CanClose), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind loc:Loc.T('大小是各进程当前占用的物理内存之和。标成“系统”的程序不会被整理或关闭。')}"
                               FontSize="12" Foreground="{x:Bind local:Palette.Faint}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
