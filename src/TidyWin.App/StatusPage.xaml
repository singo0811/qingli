<UserControl
    x:Class="TidyWin.App.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TidyWin.Core.Localization"
    xmlns:local="using:TidyWin.App">

    <Grid Padding="44,30,44,28" RowSpacing="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{x:Bind loc:Loc.T('系统健康')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
            <StackPanel Orientation="Horizontal" Spacing="22">
                <TextBlock x:Name="ScoreText" FontFamily="Bahnschrift" FontSize="116" FontWeight="SemiLight" LineHeight="120" />
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,26" Spacing="4">
                    <TextBlock x:Name="BandText" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind loc:Loc.T('满分 100,按实际占用情况扣分')}" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind loc:Loc.T('内存')}" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" />
                    <TextBlock x:Name="MemText" FontFamily="Bahnschrift" FontSize="32" Foreground="{x:Bind local:Palette.Text}" />
                    <ProgressBar x:Name="MemBar" Maximum="100" Height="4" CornerRadius="2" Foreground="#35F2B3" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind loc:Loc.T('系统盘')}" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" />
                    <TextBlock x:Name="DiskText" FontFamily="Bahnschrift" FontSize="32" Foreground="{x:Bind local:Palette.Text}" />
                    <ProgressBar x:Name="DiskBar" Maximum="100" Height="4" CornerRadius="2" Foreground="#19B9E6" />
                    <TextBlock x:Name="DiskSub" FontSize="12" Foreground="{x:Bind local:Palette.Faint}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14" Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind loc:Loc.T('已开机')}" FontSize="13" Foreground="{x:Bind local:Palette.Dim}" />
                    <TextBlock x:Name="UpText" FontFamily="Bahnschrift" FontSize="32" Foreground="{x:Bind local:Palette.Text}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="10">
            <TextBlock Text="{x:Bind loc:Loc.T('扣分原因')}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Dim}" />
            <StackPanel x:Name="Reasons" Spacing="6" />
            <Button Content="{x:Bind loc:Loc.T('重新检测')}" Click="OnRefresh" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
