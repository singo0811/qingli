<UserControl
    x:Class="TidyWin.App.AiFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TidyWin.Core.Localization"
    xmlns:local="using:TidyWin.App"
    xmlns:vm="using:TidyWin.ViewModels">

    <Grid Padding="44,30,44,28">

        <!-- ───────── 开始之前 ───────── -->
        <StackPanel x:Name="IntroView" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" Width="620">
            <TextBlock Text="{x:Bind loc:Loc.T('找出占空间的 AI 大文件')}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{x:Bind local:Palette.Text}" />
            <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="{x:Bind local:Palette.Dim}"
                       Text="{x:Bind loc:Loc.T('除了常见的缓存文件夹,真正占地方的往往是你自己放在各个盘里的模型文件(.gguf、.safetensors、.ckpt),以及每个项目各装一份的 Python 环境。这里会把它们找出来。')}" />
            <StackPanel Spacing="10" Margin="0,6,0,6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7B3;" FontSize="16" Foreground="{x:Bind local:Palette.MintBrush}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('只读取,查找时不会改动任何文件')}" FontSize="14" Foreground="{x:Bind local:Palette.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{x:Bind local:Palette.MintBrush}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('每一项都写明:为什么判断它能不能删、删掉会怎样')}" FontSize="14" Foreground="{x:Bind local:Palette.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{x:Bind local:Palette.MintBrush}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('不会替你勾选。重复的模型只合并、不删除,其余只移到回收站,都能还原')}" FontSize="14" Foreground="{x:Bind local:Palette.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{x:Bind local:Palette.MintBrush}" />
                    <TextBlock Text="{x:Bind loc:Loc.T('Windows、Program Files 等系统位置不会被查找')}" FontSize="14" Foreground="{x:Bind local:Palette.Text}" />
                </StackPanel>
            </StackPanel>
            <Button Content="{x:Bind loc:Loc.T('开始查找')}" Click="OnStart" Padding="34,12" CornerRadius="12" FontWeight="SemiBold"
                    FontSize="15" Foreground="#04110C" HorizontalAlignment="Left">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#35F2B3" Offset="0" />
                        <GradientStop Color="#19B9E6" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <TextBlock Text="{x:Bind loc:Loc.T('磁盘越大越慢,大约需要一到几分钟,可以随时停止。')}" FontSize="12" Foreground="{x:Bind local:Palette.Faint}" />
        </StackPanel>

        <!-- ───────── 查找中 ───────── -->
        <StackPanel x:Name="ScanView" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20"
                    Visibility="Collapsed" Width="640">
            <TextBlock Text="{x:Bind loc:Loc.T('正在翻找各个盘')}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{x:Bind local:Palette.Text}" />
            <Grid x:Name="ScanTrack" Width="440" Height="4" CornerRadius="2" Background="#1A2231">
                <Border Width="170" HorizontalAlignment="Left" CornerRadius="2">
                    <Border.RenderTransform><TranslateTransform x:Name="ScanShift" X="-170" /></Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0035F2B3" Offset="0" />
                            <GradientStop Color="#FF35F2B3" Offset="0.5" />
                            <GradientStop Color="#0019B9E6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <TextBlock x:Name="ScanCount" FontSize="15" HorizontalAlignment="Center" Foreground="{x:Bind local:Palette.Text}" />
            <TextBlock x:Name="ScanPath" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{x:Bind local:Palette.Faint}" TextTrimming="CharacterEllipsis" MaxWidth="640" />
            <Button Content="{x:Bind loc:Loc.T('停止并看已找到的')}" Click="OnStop" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ───────── 结果 ───────── -->
        <Grid x:Name="ReadyView" RowSpacing="18" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="{x:Bind loc:Loc.T('找到可以检查的')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="HeroNumber" Text="0" FontFamily="Bahnschrift" FontSize="96"
                               FontWeight="SemiLight" LineHeight="100" />
                    <TextBlock x:Name="HeroUnit" Text="B" FontFamily="Bahnschrift" FontSize="30"
                               VerticalAlignment="Bottom" Margin="0,0,0,16" Foreground="{x:Bind local:Palette.Dim}" />
                </StackPanel>
                <TextBlock x:Name="HeroSub" FontSize="14" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="MessageBar" Grid.Row="1" Background="#10222B" BorderBrush="#1E4A44" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}"
                               VerticalAlignment="Center" />
                    <Button x:Name="BinButton" Grid.Column="1" Content="{x:Bind loc:Loc.T('打开回收站')}" Click="OnOpenBin" Visibility="Collapsed" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="EmptyText" FontSize="16" Foreground="{x:Bind local:Palette.Dim}"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Text="{x:Bind loc:Loc.T('没有发现散落的大模型文件,也没有占地方的 Python 环境。Ollama、LM Studio、Hugging Face 里的模型请到「本地模型」页看。')}" />

                    <ItemsControl x:Name="ItemList" ItemsSource="{x:Bind ViewModel.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FoundItemViewModel">
                                <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14">
                                    <Grid MinHeight="104">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{x:Bind local:Palette.FoundBrush(Safety)}"
                                                CornerRadius="14,0,0,14" />

                                        <StackPanel Grid.Column="1" Padding="20,14,12,14" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind Owner}" FontSize="12" CharacterSpacing="80"
                                                           Foreground="{x:Bind local:Palette.Dim}" />
                                                <TextBlock Text="{x:Bind Format}" FontSize="12" Foreground="{x:Bind local:Palette.Faint}" />
                                                <TextBlock Text="{x:Bind local:Palette.FoundLabel(Safety)}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{x:Bind local:Palette.FoundBrush(Safety)}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:Palette.Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Headline}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:Palette.FoundBrush(Safety)}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind IfDeleted}" FontSize="13"
                                                       Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{x:Bind Where}" FontFamily="Cascadia Mono" FontSize="11"
                                                           Foreground="{x:Bind local:Palette.Faint}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                                <TextBlock Text="{x:Bind WhenText}" FontSize="11" Foreground="{x:Bind local:Palette.Faint}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Padding="12,12,22,12" Spacing="6"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="140">
                                            <TextBlock Text="{x:Bind SizeText}" FontFamily="Bahnschrift" FontSize="26"
                                                       HorizontalAlignment="Right" Foreground="{x:Bind local:Palette.Text}" />
                                            <CheckBox Content="{x:Bind ActionLabel}" AutomationProperties.Name="{x:Bind Name}"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}"
                                                      HorizontalAlignment="Right" MinWidth="0" />
                                            <Button Content="{x:Bind loc:Loc.T('在文件夹中显示')}" Click="OnReveal" Tag="{x:Bind Path}" Padding="10,4" FontSize="12"
                                                    HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#0C111A" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="16" Padding="18,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{x:Bind loc:Loc.T('勾选有明确理由的')}" Click="OnSelectSafe" />
                    <Button Grid.Column="1" Content="{x:Bind loc:Loc.T('清空选择')}" Click="OnClear" />
                    <Button Grid.Column="2" Content="{x:Bind loc:Loc.T('重新查找')}" Click="OnStart" />
                    <Button x:Name="MoveButton" Grid.Column="4" Click="OnMove" Padding="30,11" CornerRadius="12"
                            FontWeight="SemiBold" FontSize="15" Foreground="#04110C">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#35F2B3" Offset="0" />
                                <GradientStop Color="#19B9E6" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock x:Name="MoveButtonText" Text="{x:Bind loc:Loc.T('移到回收站')}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

