<UserControl
    x:Class="TidyWin.App.ErasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TidyWin.Core.Localization"
    xmlns:local="using:TidyWin.App"
    xmlns:vm="using:TidyWin.ViewModels">

    <Grid Padding="44,30,44,28">

        <!-- ───────── 选工具 ───────── -->
        <Grid x:Name="PickView" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="{x:Bind loc:Loc.T('清除 AI 痕迹')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
                <TextBlock Text="{x:Bind loc:Loc.T('彻底清掉一个 AI 工具的记录')}" FontSize="32" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                <TextBlock FontSize="14" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap"
                           Text="{x:Bind loc:Loc.T('对话记录、登录状态、缓存日志、环境变量里的密钥、Windows 凭据管理器里的登录,一个工具一次看全。你勾了才删。')}" />
            </StackPanel>
            <Border Grid.Row="1" Background="#221A10" BorderBrush="#5A431E" BorderThickness="1" CornerRadius="12" Padding="16,10">
                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}"
                           Text="{x:Bind loc:Loc.T('这里清的是这台电脑上的痕迹。服务器上的对话和账号不在这台电脑里,删不到:选了工具之后,我会写清楚退出登录和去官网处理的步骤。这里的删除是永久的,不进回收站,所以不会在回收站里留下记录。')}" />
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EraseToolCardViewModel">
                            <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="14" Padding="20,14">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                                        <TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="13" Foreground="{x:Bind local:Palette.CyanBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind loc:Loc.T('查看并清除')}" Click="OnPickTool" Padding="18,8" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ───────── 一个工具的详情 ───────── -->
        <Grid x:Name="DetailView" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind loc:Loc.T('清除 AI 痕迹')}" FontSize="14" CharacterSpacing="140" Foreground="{x:Bind local:Palette.Dim}" />
                    <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
                </StackPanel>
                <Border x:Name="RunningBar" Background="#2A1512" BorderBrush="#7A3A2C" BorderThickness="1" CornerRadius="12" Padding="16,10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RunningText" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
                </Border>
                <Border x:Name="MessageBar" Background="#10222B" BorderBrush="#1E4A44" BorderThickness="1" CornerRadius="12" Padding="16,10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <StackPanel Spacing="14">
                    <Border Background="#221A10" BorderBrush="#5A431E" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind loc:Loc.T('清之前先做这几件事')}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                            <TextBlock x:Name="BeforeText" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NothingText" Text="{x:Bind loc:Loc.T('在这台电脑上没有发现它留下的东西。')}" FontSize="15" Visibility="Collapsed"
                               Foreground="{x:Bind local:Palette.Dim}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="18" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EraseGroupViewModel">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Header}" FontSize="16" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.CyanBrush}" />
                                    <TextBlock Text="{x:Bind Note}" FontSize="12" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EraseItemViewModel">
                                                <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="12" Padding="16,9">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanTick}"
                                                                  MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind loc:Loc.T('清除这一项')}" />
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{x:Bind local:Palette.Dim}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind Where}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{x:Bind local:Palette.Faint}"
                                                                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="96">
                                                            <TextBlock Text="{x:Bind SizeText}" FontFamily="Bahnschrift" FontSize="16" TextAlignment="Right"
                                                                       Foreground="{x:Bind local:Palette.Text}" />
                                                            <TextBlock Text="{x:Bind CountText}" FontSize="11" TextAlignment="Right" Foreground="{x:Bind local:Palette.Faint}" />
                                                            <TextBlock Text="{x:Bind NewestText}" FontSize="11" TextAlignment="Right" Foreground="{x:Bind local:Palette.Faint}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="{x:Bind loc:Loc.T('在文件夹中显示')}" Click="OnReveal" Padding="10,4" FontSize="12" VerticalAlignment="Center"
                                                                Visibility="{x:Bind local:ErasePage.RevealVisibility(ItemType)}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#0F1520" BorderBrush="#1D2636" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind loc:Loc.T('清完之后要你自己做的')}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind local:Palette.Text}" />
                            <TextBlock x:Name="AfterText" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Dim}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{x:Bind loc:Loc.T('返回')}" Click="OnBack" Padding="16,8" />
                <Button x:Name="DryButton" Grid.Column="1" Content="{x:Bind loc:Loc.T('预演(不删)')}" Click="OnDryRun" Padding="16,8" IsEnabled="False" />
                <Button x:Name="EraseButton" Grid.Column="2" Content="{x:Bind loc:Loc.T('彻底清除所勾选的')}" Click="OnErase" Padding="18,8" IsEnabled="False" />
                <Button Grid.Column="3" Content="{x:Bind loc:Loc.T('全选 / 全不选')}" Click="OnToggleAll" Padding="14,8" />
                <TextBlock x:Name="SelectedLine" Grid.Column="4" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{x:Bind local:Palette.Dim}" />
            </Grid>
        </Grid>

        <!-- ───────── 进行中 ───────── -->
        <StackPanel x:Name="BusyView" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" Visibility="Collapsed" Width="600">
            <ProgressRing IsActive="True" Width="44" Height="44" />
            <TextBlock x:Name="BusyTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
        </StackPanel>

        <!-- ───────── 完成 ───────── -->
        <ScrollViewer x:Name="DoneView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="660" Padding="0,30">
                <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{x:Bind local:Palette.CyanBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DoneTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
                <TextBlock x:Name="DoneDetail" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{x:Bind local:Palette.Dim}" />
                <Border Background="#221A10" BorderBrush="#5A431E" BorderThickness="1" CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind loc:Loc.T('还有这些要你自己做(服务器上的和浏览器里的不在这台电脑里)')}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{x:Bind local:Palette.Text}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DoneAfter" FontSize="13" TextWrapping="Wrap" Foreground="{x:Bind local:Palette.Text}" />
                    </StackPanel>
                </Border>
                <Button Content="{x:Bind loc:Loc.T('回到列表')}" Click="OnBack" HorizontalAlignment="Center" Padding="22,8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
